body {
	font-family: LatoLatin;
	font-size: 18px;
	color: #f2efe6;
	background-color: #1b1d2a;
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 24px;
	box-sizing: border-box;
}

h1, p {
	display: block;
}

h1 {
	font-size: 36px;
	font-weight: bold;
	color: #ffcf3f;
	margin: 0 0 12px 0;
}

.hint {
	color: #b8b6c4;
	margin: 0 0 16px 0;
}

.path {
	background-color: #272a3c;
	padding: 8px 12px;
	margin: 6px 0;
}

.status {
	min-height: 24px;
	color: #ff9b8a;
	margin: 8px 0;
}

.row {
	margin: 0 0 8px 0;
}

.pane {
	margin: 12px 0;
}

button {
	display: inline-block;
	background-color: #33384f;
	color: #f2efe6;
	padding: 10px 18px;
	margin: 0 12px 8px 0;
	border-radius: 6px;
}

button:hover {
	background-color: #444c6d;
}

button.primary {
	background-color: #d8a21c;
	color: #1b1d2a;
	font-weight: bold;
}

button.tab {
	padding: 8px 14px;
}

button.tab.active {
	background-color: #d8a21c;
	color: #1b1d2a;
}

.keys {
	margin: 8px 0;
}

.keys button {
	width: 230px;
	text-align: left;
}
