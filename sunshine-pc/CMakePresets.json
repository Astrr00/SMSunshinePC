{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-clang-relwithdebinfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-clang-debug",
      "inherits": "windows-clang-relwithdebinfo",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-relwithdebinfo", "configurePreset": "windows-clang-relwithdebinfo" },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" }
  ]
}
