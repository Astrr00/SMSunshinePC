+
+namespace {
+std::atomic<void (*)()> sHostWaitBegin{nullptr};
+std::atomic<void (*)()> sHostWaitEnd{nullptr};
+} // namespace
+
+void set_host_wait_hooks(void (*begin)(), void (*end)()) noexcept {
+  sHostWaitBegin.store(begin);
+  sHostWaitEnd.store(end);
+}
+
+HostWaitScope::HostWaitScope() noexcept {
+  if (auto* begin = sHostWaitBegin.load()) {
+    begin();
+  }
+}
+
+HostWaitScope::~HostWaitScope() noexcept {
+  if (auto* end = sHostWaitEnd.load()) {
+    end();
+  }
+}
+
 } // namespace aurora::thread
