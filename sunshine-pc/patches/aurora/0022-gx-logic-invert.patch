diff --git a/tests/gx_logic_op_test.cpp b/tests/gx_logic_op_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/gx_logic_op_test.cpp
@@ -0,0 +1,95 @@
+#include <gtest/gtest.h>
+
+#include "gx/gx.hpp"
+#include "gx/pipeline.hpp"
+
+namespace aurora::gx {
+namespace {
+
+ShaderConfig shader_config() {
+  ShaderConfig config{};
+  config.attrs[GX_VA_POS] = {.attrType = GX_DIRECT, .cnt = 3, .compType = GX_F32};
+  config.vtxStride = 12;
+  config.tevStageCount = 1;
+  config.fogType = GX_FOG_PERSP_LIN;
+  config.alphaCompare = {GX_GREATER, 128, GX_AOP_AND, GX_ALWAYS, 0};
+  return config;
+}
+
+TEST(GXLogicInvTest, ShaderOverrideFollowsFogAndOriginalAlphaTest) {
+  auto config = shader_config();
+  const auto original = build_shader_source(config, DstAlphaMode::None);
+  EXPECT_EQ(original.find("// GX_LO_INV"), std::string::npos);
+  const auto ordinaryConfig = config;
+  config.logicInv = true;
+  EXPECT_FALSE(config == ordinaryConfig); // This byte representation is the shader-cache key.
+  const auto source = build_shader_source(config, DstAlphaMode::None);
+  const auto fog = source.find("mix(prev.rgb, ubuf.fog.color.rgb");
+  const auto alpha = source.find("let alphaCompare =");
+  const auto discard = source.find("discard;", alpha);
+  const auto invert = source.find("// GX_LO_INV\n    prev = vec4f(1.0);");
+  ASSERT_NE(fog, std::string::npos);
+  ASSERT_NE(alpha, std::string::npos);
+  ASSERT_NE(discard, std::string::npos);
+  ASSERT_NE(invert, std::string::npos);
+  EXPECT_LT(fog, invert);
+  EXPECT_LT(discard, invert);
+  EXPECT_LT(invert, source.find("return prev;", invert));
+}
+
+TEST(GXLogicInvTest, DestinationAlphaReplacementStillFollowsAlphaTest) {
+  auto config = shader_config();
+  config.logicInv = true;
+  const auto source = build_shader_source(config, DstAlphaMode::Replace);
+  const auto invert = source.find("// GX_LO_INV");
+  const auto replace = source.find("prev.a = 1.0;", invert);
+  ASSERT_NE(invert, std::string::npos);
+  ASSERT_NE(replace, std::string::npos);
+  EXPECT_LT(source.find("discard;"), invert);
+  EXPECT_LT(invert, replace);
+}
+
+TEST(GXLogicInvTest, BlendInvertsDestinationRGBAAndKeepsConstantAlphaOverride) {
+  for (bool dualSource : {false, true}) {
+    const auto blend = to_blend_state(GX_BM_LOGIC, GX_BL_ZERO, GX_BL_ONE, GX_LO_INV, UINT32_MAX, dualSource);
+    EXPECT_EQ(blend.color.operation, wgpu::BlendOperation::Add);
+    EXPECT_EQ(blend.color.srcFactor, wgpu::BlendFactor::OneMinusDst);
+    EXPECT_EQ(blend.color.dstFactor, wgpu::BlendFactor::Zero);
+    EXPECT_EQ(blend.alpha.operation, wgpu::BlendOperation::Add);
+    EXPECT_EQ(blend.alpha.srcFactor, wgpu::BlendFactor::OneMinusDst);
+    EXPECT_EQ(blend.alpha.dstFactor, wgpu::BlendFactor::Zero);
+    for (u32 alpha : {0u, 127u, 255u}) {
+      const auto constant = to_blend_state(GX_BM_LOGIC, GX_BL_ZERO, GX_BL_ONE, GX_LO_INV, alpha, dualSource);
+      EXPECT_EQ(constant.color.srcFactor, blend.color.srcFactor);
+      EXPECT_EQ(constant.color.dstFactor, blend.color.dstFactor);
+      EXPECT_EQ(constant.alpha.operation, wgpu::BlendOperation::Add);
+      EXPECT_EQ(constant.alpha.srcFactor, wgpu::BlendFactor::Constant);
+      EXPECT_EQ(constant.alpha.dstFactor, wgpu::BlendFactor::Zero);
+    }
+  }
+  EXPECT_EQ(to_write_mask(false, false), wgpu::ColorWriteMask::None);
+  EXPECT_EQ(to_write_mask(true, false),
+            wgpu::ColorWriteMask::Red | wgpu::ColorWriteMask::Green | wgpu::ColorWriteMask::Blue);
+  EXPECT_EQ(to_write_mask(false, true), wgpu::ColorWriteMask::Alpha);
+  EXPECT_EQ(to_write_mask(true, true), wgpu::ColorWriteMask::All);
+}
+
+TEST(GXLogicInvTest, PipelineSelectsOverrideOnlyForEnabledInvertLogic) {
+  const auto saved = g_gxState;
+  g_gxState = {};
+  g_gxState.dstAlpha = UINT32_MAX;
+  PipelineConfig config{};
+  g_gxState.blendOp = GX_LO_INV;
+  for (auto mode : {GX_BM_NONE, GX_BM_BLEND, GX_BM_SUBTRACT, GX_BM_LOGIC}) {
+    g_gxState.blendMode = mode;
+    populate_pipeline_config(config, GX_TRIANGLES, GX_VTXFMT0);
+    EXPECT_EQ(bool(config.shaderConfig.logicInv), mode == GX_BM_LOGIC);
+  }
+  g_gxState.blendOp = GX_LO_COPY;
+  populate_pipeline_config(config, GX_TRIANGLES, GX_VTXFMT0);
+  EXPECT_FALSE(config.shaderConfig.logicInv);
+  g_gxState = saved;
+}
