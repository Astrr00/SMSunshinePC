+
+GXDrawSyncCallback GXSetDrawSyncCallback(GXDrawSyncCallback cb) {
+  return aurora::gfx::pixel_metric::set_draw_sync_callback(cb);
+}
+
+// A token that closes a pixel metric segment is delivered asynchronously: the callback runs on the render
+// thread after the segment's occlusion queries resolve (see pixel_metric.hpp). Other tokens keep the
+// synchronous behavior: the callback runs before GXSetDrawSync returns.
+void GXSetDrawSync(u16 token) {
+  if (sPixMetricOpen) {
+    sPixMetricOpen = false;
+    GX_WRITE_AURORA(GX_AURORA_DRAW_SYNC);
+    GX_WRITE_U16(token);
+    return;
+  }
+  const auto callback = aurora::gfx::pixel_metric::draw_sync_callback();
+  if (callback == nullptr) {
+    return;
+  }
+  AuroraGXSync();
+  callback(token);
+}
+
+void GXClearPixMetric(void) {
+  sPixMetricOpen = true;
+  GX_WRITE_AURORA(GX_AURORA_CLEAR_PIX_METRIC);
+}
+
+// ponytail: only clrIn (the occlusion sample count) is implemented; top/bottom counters and clocks read as zero.
+void GXReadPixMetric(u32* topIn, u32* topOut, u32* botIn, u32* botOut, u32* clrIn, u32* clocks) {
+  if (topIn != nullptr) {
+    *topIn = 0;
+  }
+  if (topOut != nullptr) {
+    *topOut = 0;
+  }
+  if (botIn != nullptr) {
+    *botIn = 0;
+  }
+  if (botOut != nullptr) {
+    *botOut = 0;
+  }
+  if (clrIn != nullptr) {
+    *clrIn = aurora::gfx::pixel_metric::read_count();
+  }
+  if (clocks != nullptr) {
+    *clocks = 0;
+  }
+}
+
+} // extern "C"
