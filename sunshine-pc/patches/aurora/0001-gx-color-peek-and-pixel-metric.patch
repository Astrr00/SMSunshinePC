new file mode 100644
--- /dev/null
+++ b/lib/gfx/pixel_metric.cpp
@@ -0,0 +1,153 @@
+#include "pixel_metric.hpp"
+
+#include "frame_packet.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <memory>
+#include <vector>
+
+#include <magic_enum.hpp>
+
+namespace aurora::gfx::pixel_metric {
+namespace {
+Module Log("aurora::gfx::pixel_metric");
+
+using webgpu::g_device;
+
+enum class BatchStatus : uint8_t { Pending, Ok, Failed };
+
+// One batch per frame that issued draw-sync tokens. Shared with the MapAsync callback, which may run on another thread.
+struct Batch {
+  std::vector<detail::SyncToken> tokens;
+  wgpu::Buffer readback;
+  uint64_t byteSize = 0;
+  bool mapRequested = false;
+  std::atomic<BatchStatus> status{BatchStatus::Pending};
+};
+
+// Render thread only, except g_callback and g_last which are read from the game thread.
+std::deque<std::shared_ptr<Batch>> g_batches;
+std::atomic<DrawSyncCallback> g_callback{nullptr};
+std::atomic<uint32_t> g_last{0};
+
+thread_local bool tDispatching = false;
+thread_local uint32_t tCount = 0;
+
+// Sums the resolved query values of one token. Each query value is a sample count; clamp to u32.
+uint32_t token_count(const detail::SyncToken& token, const uint64_t* values) {
+  uint64_t sum = 0;
+  for (const auto index : token.queries) {
+    sum += values[index];
+  }
+  return static_cast<uint32_t>(std::min<uint64_t>(sum, std::numeric_limits<uint32_t>::max()));
+}
+
+void dispatch(uint16_t token, uint32_t count) {
+  g_last.store(count, std::memory_order_relaxed);
+  const auto callback = g_callback.load(std::memory_order_acquire);
+  if (callback == nullptr) {
+    return;
+  }
+  tDispatching = true;
+  tCount = count;
+  callback(token);
+  tDispatching = false;
+}
+} // namespace
+
+DrawSyncCallback set_draw_sync_callback(DrawSyncCallback callback) noexcept {
+  return g_callback.exchange(callback, std::memory_order_acq_rel);
+}
+
+DrawSyncCallback draw_sync_callback() noexcept { return g_callback.load(std::memory_order_acquire); }
+
+void finish_frame(const wgpu::CommandEncoder& encoder, detail::FramePacket& packet) noexcept {
+  if (packet.syncTokens.empty()) {
+    return;
+  }
+  auto batch = std::make_shared<Batch>();
+  batch->tokens = std::move(packet.syncTokens);
+  packet.syncTokens.clear();
+
+  const uint32_t queryCount = packet.occlusionCount;
+  if (queryCount == 0 || !packet.occlusionQuerySet) {
+    // Nothing was counted this frame, so every token in the batch reports zero.
+    batch->status.store(BatchStatus::Ok, std::memory_order_release);
+  } else {
+    // ponytail: per-frame buffers; pool them if per-frame allocation shows up in profiles.
+    batch->byteSize = static_cast<uint64_t>(queryCount) * sizeof(uint64_t);
+    const wgpu::BufferDescriptor resolveDescriptor{
+        .label = "Pixel Metric Resolve Buffer",
+        .usage = wgpu::BufferUsage::QueryResolve | wgpu::BufferUsage::CopySrc,
+        .size = batch->byteSize,
+    };
+    const auto resolve = g_device.CreateBuffer(&resolveDescriptor);
+    const wgpu::BufferDescriptor readbackDescriptor{
+        .label = "Pixel Metric Readback Buffer",
+        .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+        .size = batch->byteSize,
+    };
+    batch->readback = g_device.CreateBuffer(&readbackDescriptor);
+    encoder.ResolveQuerySet(packet.occlusionQuerySet, 0, queryCount, resolve, 0);
+    encoder.CopyBufferToBuffer(resolve, 0, batch->readback, 0, batch->byteSize);
+  }
+  g_batches.push_back(std::move(batch));
+}
+
+void after_submit() noexcept {
+  for (auto& batch : g_batches) {
+    if (batch->mapRequested || !batch->readback) {
+      continue;
+    }
+    batch->mapRequested = true;
+    batch->readback.MapAsync(
+        wgpu::MapMode::Read, 0, batch->byteSize, wgpu::CallbackMode::AllowSpontaneous,
+        [batch](wgpu::MapAsyncStatus status, wgpu::StringView message) {
+          if (status == wgpu::MapAsyncStatus::Success) {
+            batch->status.store(BatchStatus::Ok, std::memory_order_release);
+          } else {
+            if (status != wgpu::MapAsyncStatus::CallbackCancelled && status != wgpu::MapAsyncStatus::Aborted) {
+              Log.warn("Pixel metric readback mapping failed {}: {}", magic_enum::enum_name(status), message);
+            }
+            batch->status.store(BatchStatus::Failed, std::memory_order_release);
+          }
+        });
+  }
+}
+
+void poll() noexcept {
+  while (!g_batches.empty()) {
+    auto& batch = *g_batches.front();
+    const auto status = batch.status.load(std::memory_order_acquire);
+    if (status == BatchStatus::Pending) {
+      break;
+    }
+
+    const uint64_t* values = nullptr;
+    if (status == BatchStatus::Ok && batch.readback) {
+      values = static_cast<const uint64_t*>(batch.readback.GetConstMappedRange(0, batch.byteSize));
+    }
+    for (const auto& token : batch.tokens) {
+      // Failed or unmapped batches report zero rather than stalling the game's draw-sync callbacks.
+      dispatch(token.token, values != nullptr ? token_count(token, values) : 0);
+    }
+    if (values != nullptr) {
+      batch.readback.Unmap();
+    }
+    g_batches.pop_front();
+  }
+}
+
+uint32_t read_count() noexcept { return tDispatching ? tCount : g_last.load(std::memory_order_relaxed); }
+
+void shutdown() noexcept {
+  g_batches.clear();
+  g_last.store(0, std::memory_order_relaxed);
+}
+
+} // namespace aurora::gfx::pixel_metric
