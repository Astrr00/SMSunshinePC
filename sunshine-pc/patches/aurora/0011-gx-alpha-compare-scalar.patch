+  } else if (op == GX_TEV_COMP_R8_EQ || op == GX_TEV_COMP_GR16_EQ || op == GX_TEV_COMP_BGR24_EQ) {
     op = GX_TEV_COMP_RGB8_EQ;
   }
   std::string expr = tev_op(op, bias, scale, a, b, c, d, "0.0"sv);
