 // END AREA SAMPLER REGION
 
+fn luma(c: vec3<f32>) -> f32 {
+    return dot(c, vec3<f32>(0.2126, 0.7152, 0.0722));
+}
+
+// EASU-style upscale: 4x4 gaussian gather whose kernel is stretched along the local luma edge
+// (edge tangent taken from the 2x2 luma gradient), so edges stay straight instead of blurring.
+// Own implementation of the technique; not AMD FidelityFX code.
+fn sample_easu(frag_position: vec4<f32>) -> vec4<f32> {
+    let source_size = vec2<f32>(textureDimensions(t));
+    let target_size = max(vec2<f32>(uniforms.frame_width, uniforms.frame_height), vec2<f32>(1.0, 1.0));
+    let src = (frag_position.xy - vec2<f32>(0.5, 0.5)) * (source_size / target_size);
+    let base = floor(src);
+    let f_pos = src - base;
+    let ip = vec2<i32>(base);
+
+    let l00 = luma(sample_by_pixel(ip).rgb);
+    let l10 = luma(sample_by_pixel(ip + vec2<i32>(1, 0)).rgb);
+    let l01 = luma(sample_by_pixel(ip + vec2<i32>(0, 1)).rgb);
+    let l11 = luma(sample_by_pixel(ip + vec2<i32>(1, 1)).rgb);
+    let grad = vec2<f32>((l10 + l11) - (l00 + l01), (l01 + l11) - (l00 + l10));
+    let grad_len = length(grad);
+    var along = vec2<f32>(1.0, 0.0);
+    if (grad_len > 1e-4) {
+        along = vec2<f32>(-grad.y, grad.x) / grad_len;
+    }
+    let across = vec2<f32>(-along.y, along.x);
+    let edge = clamp(grad_len * 2.0, 0.0, 1.0);
+    let sigma_along = 0.7 + 0.6 * edge;
+    let sigma_across = 0.6;
+
+    var color = vec4<f32>(0.0, 0.0, 0.0, 0.0);
+    var total_weight = 0.0;
+    for (var oy: i32 = -1; oy <= 2; oy = oy + 1) {
+        for (var ox: i32 = -1; ox <= 2; ox = ox + 1) {
+            let d = vec2<f32>(f32(ox), f32(oy)) - f_pos;
+            let a = dot(d, along) / sigma_along;
+            let b = dot(d, across) / sigma_across;
+            let weight = exp(-0.5 * (a * a + b * b));
+            color += weight * sample_by_pixel(ip + vec2<i32>(ox, oy));
+            total_weight += weight;
+        }
+    }
+    return color / total_weight;
+}
+
+// RCAS-style sharpen (unsharp-mask form) over the EASU output. Own implementation.
+// ponytail: no FSR-style local min/max halo limiter; output is clamped to [0,1] only. Upgrade if halos show.
+@fragment
+fn fs_rcas(in: VertexOutput) -> @location(0) vec4<f32> {
+    let p = vec2<i32>(in.position.xy);
+    let center = sample_by_pixel(p).rgb;
+    let north = sample_by_pixel(p + vec2<i32>(0, -1)).rgb;
+    let south = sample_by_pixel(p + vec2<i32>(0, 1)).rgb;
+    let east = sample_by_pixel(p + vec2<i32>(1, 0)).rgb;
+    let west = sample_by_pixel(p + vec2<i32>(-1, 0)).rgb;
+    let k = 0.25 * clamp(uniforms.sharpness, 0.0, 1.0);
+    let sharpened = (1.0 + 4.0 * k) * center - k * (north + south + east + west);
+    return vec4<f32>(clamp(sharpened, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
+}
+
+
 @fragment
 fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
