+template <uint32_t Width, uint32_t Height, uint32_t RowPitch>
+constexpr bool check_z24x8_packing() {
+  std::array<uint8_t, RowPitch * Height> rgba{};
+  std::array<uint8_t, Width * Height * 4> tiled{};
+  for (auto& byte : rgba) {
+    byte = 0xA5; // Padding and alpha must never enter either depth plane.
+  }
+  for (uint32_t i = 0; i < Width * Height; ++i) {
+    const uint32_t z = i == 0 ? 0x123456 : i == 1 ? 0 : i == 2 ? 0xFFFFFF : (i * 0x12345) & 0xFFFFFF;
+    const size_t offset = static_cast<size_t>(i / Width) * RowPitch + (i % Width) * 4;
+    rgba[offset] = static_cast<uint8_t>(z >> 16);
+    rgba[offset + 1] = static_cast<uint8_t>(z >> 8);
+    rgba[offset + 2] = static_cast<uint8_t>(z);
+  }
+  pack_z24x8(rgba.data(), Width, Height, RowPitch, tiled.data());
+  size_t tile = 0;
+  for (uint32_t tileY = 0; tileY < Height; tileY += 4) {
+    for (uint32_t tileX = 0; tileX < Width; tileX += 4, tile += 64) {
+      for (uint32_t p = 0; p < 16; ++p) {
+        const uint32_t i = (tileY + p / 4) * Width + tileX + p % 4;
+        const uint32_t expected = i == 0 ? 0x123456 : i == 1 ? 0 : i == 2 ? 0xFFFFFF : (i * 0x12345) & 0xFFFFFF;
+        const uint32_t z = (uint32_t{tiled[tile + p * 2 + 1]} << 16) |
+                           (uint32_t{tiled[tile + 32 + p * 2]} << 8) | tiled[tile + 32 + p * 2 + 1];
+        if (tiled[tile + p * 2] != 0 || z != expected) {
+          return false;
+        }
+      }
+    }
+  }
+  return true;
+}
+static_assert(check_z24x8_packing<4, 4, 256>());
+static_assert(check_z24x8_packing<84, 8, 512>());
