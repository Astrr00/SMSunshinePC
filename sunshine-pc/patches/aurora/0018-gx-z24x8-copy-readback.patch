+      const size_t pixel = ((y & 3) * 4 + (x & 3)) * 2;
+      tiled[tile + pixel] = 0;
+      tiled[tile + pixel + 1] = row[x * 4];
+      tiled[tile + 32 + pixel] = row[x * 4 + 1];
+      tiled[tile + 32 + pixel + 1] = row[x * 4 + 2];
+    }
+  }
