+// GX aliases references beyond the enabled texgens to coordinate zero (also for indirect stages).
+constexpr GXTexCoordID active_texcoord(GXTexCoordID id, u8 count) {
+  return id != GX_TEXCOORD_NULL && id >= count ? GX_TEXCOORD0 : id;
+}
+static_assert(active_texcoord(GX_TEXCOORD1, 1) == GX_TEXCOORD0);
+static_assert(active_texcoord(GX_TEXCOORD1, 2) == GX_TEXCOORD1);
+static_assert(active_texcoord(GX_TEXCOORD_NULL, 1) == GX_TEXCOORD_NULL);
