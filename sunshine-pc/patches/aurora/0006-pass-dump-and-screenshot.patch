+#pragma once
+
+// Opt-in capture of one presented frame as PNG (golden-image tests, before/after checks).
+//
+// AURORA_SCREENSHOT=<frame>:<file.png> writes the image that is presented for Aurora frame <frame>, numbered like
+// gfx::current_frame() and AURORA_DUMP_PASSES. The present passes are re-encoded into an offscreen texture of the
+// surface size and read back after submit, so the swapchain is never copied from. When the variable is unset,
+// selected() is one cached check and nothing else runs.
+
+#include "../imgui.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <webgpu/webgpu_cpp.h>
+
+#include <cstdint>
+#include <memory>
+
+namespace aurora::gfx::screenshot {
+struct Capture;
+using CapturePtr = std::shared_ptr<Capture>;
+
+// Main thread: true when frameIndex is the AURORA_SCREENSHOT frame.
+bool selected(uint32_t frameIndex) noexcept;
+// Render worker, before the encoder is finished: records the present passes into an offscreen target and a readback.
+// Returns null when the surface format is not RGBA8/BGRA8.
+CapturePtr record(wgpu::CommandEncoder& encoder, const wgpu::BindGroup& presentBindGroup,
+                  const wgpu::BindGroup& rmlBindGroup, bool rmlOverlay, const webgpu::Viewport& viewport,
+                  const imgui::DrawData& imguiData);
+// Render worker, after submit: maps the readback and writes the PNG. Null is a no-op.
+void finish(const CapturePtr& capture);
+} // namespace aurora::gfx::screenshot
