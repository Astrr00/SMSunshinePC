+++ b/lib/gfx/screenshot.cpp
@@ -0,0 +1,304 @@
+#include "screenshot.hpp"
+
+#include "../logging.hpp"
+
+#include <png.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <optional>
+#include <mutex>
+#include <string>
+#include <vector>
+
+static aurora::Module Log("aurora::gfx::screenshot");
+
+namespace aurora::gfx::screenshot {
+namespace {
+struct Request {
+  uint32_t frame = 0;
+  std::string path;
+};
+
+// Parsed once. Empty when AURORA_SCREENSHOT is unset or malformed.
+const std::optional<Request>& request() noexcept {
+  static const std::optional<Request> parsed = [] {
+    std::optional<Request> out;
+    const char* env = std::getenv("AURORA_SCREENSHOT");
+    if (env == nullptr || *env == '\0') {
+      return out;
+    }
+    char* end = nullptr;
+    const unsigned long frame = std::strtoul(env, &end, 10);
+    if (end == env || *end != ':' || end[1] == '\0') {
+      Log.warn("AURORA_SCREENSHOT='{}' ignored; expected <frame>:<file.png>", env);
+      return out;
+    }
+    out = Request{static_cast<uint32_t>(frame), std::string(end + 1)};
+    Log.info("screenshot: frame {} -> {}", out->frame, out->path);
+    return out;
+  }();
+  return parsed;
+}
+
+// Monitor mode: AURORA_SCREENSHOT_EVERY=<n>:<file.png> overwrites <file.png> every n presented frames (atomically, via a
+// temp file), so a developer can look at the real frame at any time regardless of window stacking or occlusion.
+struct Monitor {
+  uint32_t every = 0;
+  std::string path;
+};
+const Monitor& monitor() noexcept {
+  static const Monitor parsed = [] {
+    Monitor out;
+    const char* env = std::getenv("AURORA_SCREENSHOT_EVERY");
+    if (env == nullptr || *env == '\0') {
+      return out;
+    }
+    char* end = nullptr;
+    const unsigned long every = std::strtoul(env, &end, 10);
+    if (end == env || *end != ':' || end[1] == '\0' || every == 0) {
+      Log.warn("AURORA_SCREENSHOT_EVERY='{}' ignored; expected <n>:<file.png>", env);
+      return out;
+    }
+    out.every = static_cast<uint32_t>(every);
+    out.path = std::string(end + 1);
+    Log.info("screenshot monitor: every {} frames -> {}", out.every, out.path);
+    return out;
+  }();
+  return parsed;
+}
+
+// One-shot request from devscript (requestNext): the next selected frame is written to gPendingPath.
+std::atomic<bool> gPendingFlag{false};
+std::mutex gRequestMutex;
+std::string gPendingPath;
+std::string gClaimedPath;
+
+} // namespace
+
+struct Capture {
+  wgpu::Buffer buffer;
+  std::string path;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t bytesPerRow = 0;
+  bool bgra = false;
+};
+
+namespace {
+
+// Same scissor rule as the present blit in aurora.cpp (set_present_viewport).
+uint32_t clamp_coord(double value, uint32_t maximum) noexcept {
+  return static_cast<uint32_t>(std::clamp(value, 0.0, static_cast<double>(maximum)));
+}
+
+bool write_png(const std::string& path, const Capture& capture, const uint8_t* data) {
+  FILE* file = std::fopen(path.c_str(), "wb");
+  if (file == nullptr) {
+    return false;
+  }
+  png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+  png_infop info = png != nullptr ? png_create_info_struct(png) : nullptr;
+  if (info == nullptr) {
+    png_destroy_write_struct(&png, nullptr);
+    std::fclose(file);
+    return false;
+  }
+  if (setjmp(png_jmpbuf(png))) {
+    png_destroy_write_struct(&png, &info);
+    std::fclose(file);
+    return false;
+  }
+  png_init_io(png, file);
+  png_set_IHDR(png, info, capture.width, capture.height, 8, PNG_COLOR_TYPE_RGBA, PNG_INTERLACE_NONE,
+               PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+  png_write_info(png, info);
+  std::vector<uint8_t> row(static_cast<size_t>(capture.width) * 4);
+  for (uint32_t y = 0; y < capture.height; ++y) {
+    const uint8_t* src = data + static_cast<size_t>(y) * capture.bytesPerRow;
+    for (uint32_t x = 0; x < capture.width; ++x) {
+      const uint8_t* s = src + x * 4;
+      uint8_t* d = &row[x * 4];
+      d[0] = capture.bgra ? s[2] : s[0];
+      d[1] = s[1];
+      d[2] = capture.bgra ? s[0] : s[2];
+      d[3] = s[3];
+    }
+    png_write_row(png, row.data());
+  }
+  png_write_end(png, nullptr);
+  png_destroy_write_struct(&png, &info);
+  std::fclose(file);
+  return true;
+}
+} // namespace
+
+bool selected(uint32_t frameIndex) noexcept {
+  if (gPendingFlag.load(std::memory_order_acquire)) {
+    std::lock_guard<std::mutex> lock(gRequestMutex);
+    gClaimedPath = gPendingPath;
+    gPendingPath.clear();
+    gPendingFlag.store(false, std::memory_order_release);
+    return true;
+  }
+  const auto& mon = monitor();
+  if (mon.every != 0 && frameIndex % mon.every == 0) {
+    std::lock_guard<std::mutex> lock(gRequestMutex);
+    gClaimedPath = mon.path;
+    return true;
+  }
+  const auto& req = request();
+  return req.has_value() && req->frame == frameIndex;
+}
+
+CapturePtr record(wgpu::CommandEncoder& encoder, const wgpu::BindGroup& presentBindGroup,
+                  const wgpu::BindGroup& rmlBindGroup, bool rmlOverlay, const webgpu::Viewport& viewport,
+                  const imgui::DrawData& imguiData) {
+  const auto& config = webgpu::g_graphicsConfig.surfaceConfiguration;
+  const auto format = config.format;
+  const bool bgra = format == wgpu::TextureFormat::BGRA8Unorm || format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  const bool rgba = format == wgpu::TextureFormat::RGBA8Unorm || format == wgpu::TextureFormat::RGBA8UnormSrgb;
+  if (!bgra && !rgba) {
+    Log.warn("screenshot skipped: surface format {}", static_cast<uint32_t>(format));
+    return nullptr;
+  }
+
+  const wgpu::Extent3D size{config.width, config.height, 1};
+  const wgpu::TextureDescriptor textureDesc{
+      .label = "Screenshot target",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::CopySrc,
+      .dimension = wgpu::TextureDimension::e2D,
+      .size = size,
+      .format = format,
+      .mipLevelCount = 1,
+  };
+  const wgpu::Texture target = webgpu::g_device.CreateTexture(&textureDesc);
+  const wgpu::TextureView targetView = target.CreateView();
+
+  {
+    const std::array attachments{
+        wgpu::RenderPassColorAttachment{
+            .view = targetView,
+            .loadOp = wgpu::LoadOp::Clear,
+            .storeOp = wgpu::StoreOp::Store,
+        },
+    };
+    const wgpu::RenderPassDescriptor renderPassDescriptor{
+        .label = "Screenshot blit pass",
+        .colorAttachmentCount = attachments.size(),
+        .colorAttachments = attachments.data(),
+    };
+    const auto pass = encoder.BeginRenderPass(&renderPassDescriptor);
+    pass.SetPipeline(webgpu::g_CopyPipeline);
+    pass.SetBindGroup(0, presentBindGroup, 0, nullptr);
+    pass.SetViewport(viewport.left, viewport.top, viewport.width, viewport.height, viewport.znear, viewport.zfar);
+    const auto scissorX = clamp_coord(std::floor(viewport.left), config.width);
+    const auto scissorY = clamp_coord(std::floor(viewport.top), config.height);
+    const auto scissorRight = clamp_coord(std::ceil(viewport.left + viewport.width), config.width);
+    const auto scissorBottom = clamp_coord(std::ceil(viewport.top + viewport.height), config.height);
+    pass.SetScissorRect(scissorX, scissorY, scissorRight - scissorX, scissorBottom - scissorY);
+    pass.Draw(3);
+    if (rmlBindGroup && rmlOverlay) {
+      pass.SetPipeline(webgpu::g_CopyPremultipliedAlphaPipeline);
+      pass.SetBindGroup(0, rmlBindGroup, 0, nullptr);
+      pass.Draw(3);
+    }
+    pass.End();
+  }
+  {
+    const std::array attachments{
+        wgpu::RenderPassColorAttachment{
+            .view = targetView,
+            .loadOp = wgpu::LoadOp::Load,
+            .storeOp = wgpu::StoreOp::Store,
+        },
+    };
+    const wgpu::RenderPassDescriptor renderPassDescriptor{
+        .label = "Screenshot ImGui pass",
+        .colorAttachmentCount = attachments.size(),
+        .colorAttachments = attachments.data(),
+    };
+    const auto pass = encoder.BeginRenderPass(&renderPassDescriptor);
+    pass.SetViewport(0.f, 0.f, static_cast<float>(config.width), static_cast<float>(config.height), 0.f, 1.f);
+    imgui::render(pass, imguiData);
+    pass.End();
+  }
+
+  auto capture = std::make_shared<Capture>();
+  {
+    std::lock_guard<std::mutex> lock(gRequestMutex);
+    capture->path = !gClaimedPath.empty() ? gClaimedPath : (request().has_value() ? request()->path : monitor().path);
+    gClaimedPath.clear();
+  }
+  capture->width = config.width;
+  capture->height = config.height;
+  capture->bytesPerRow = (config.width * 4 + 255) & ~255u;
+  capture->bgra = bgra;
+  const wgpu::BufferDescriptor bufferDesc{
+      .label = "Screenshot readback",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = static_cast<uint64_t>(capture->bytesPerRow) * capture->height,
+  };
+  capture->buffer = webgpu::g_device.CreateBuffer(&bufferDesc);
+  const wgpu::TexelCopyTextureInfo src{.texture = target};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = capture->bytesPerRow, .rowsPerImage = capture->height},
+      .buffer = capture->buffer,
+  };
+  encoder.CopyTextureToBuffer(&src, &dst, &size);
+  return capture;
+}
+
+void finish(const CapturePtr& capture) {
+  if (!capture) {
+    return;
+  }
+  const uint64_t bytes = static_cast<uint64_t>(capture->bytesPerRow) * capture->height;
+  wgpu::MapAsyncStatus status = wgpu::MapAsyncStatus::Error;
+  auto future = capture->buffer.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::WaitAnyOnly,
+                                         [&status](wgpu::MapAsyncStatus s, wgpu::StringView) { status = s; });
+  webgpu::g_instance.WaitAny(future, 5'000'000'000ull);
+  if (status != wgpu::MapAsyncStatus::Success) {
+    Log.error("screenshot readback failed for {}", capture->path);
+    return;
+  }
+  const auto* data = static_cast<const uint8_t*>(capture->buffer.GetConstMappedRange(0, bytes));
+  const bool isMonitor = monitor().every != 0 && capture->path == monitor().path;
+  const std::string target = isMonitor ? capture->path + ".tmp" : capture->path;
+  bool ok = write_png(target, *capture, data);
+  if (ok && isMonitor) {
+    std::error_code ec;
+    std::filesystem::rename(target, capture->path, ec);
+    ok = !ec;
+  }
+  if (ok) {
+    if (isMonitor) {
+      capture->buffer.Unmap();
+      return;
+    }
+    Log.info("screenshot written: {} ({}x{})", capture->path, capture->width, capture->height);
+  } else {
+    Log.error("screenshot PNG write failed: {}", capture->path);
+  }
+  capture->buffer.Unmap();
+}
+
+void requestNext(const char* path) {
+  if (path == nullptr || *path == '\0') {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(gRequestMutex);
+  gPendingPath = path;
+  gPendingFlag.store(true, std::memory_order_release);
+}
+} // namespace aurora::gfx::screenshot
+
+// C entry point for src/devscript (`shot <path>`).
+extern "C" void aurora_screenshot_next(const char* path) {
+  aurora::gfx::screenshot::requestNext(path);
+}
