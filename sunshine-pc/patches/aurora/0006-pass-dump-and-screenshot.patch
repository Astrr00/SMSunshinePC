diff --git a/lib/gfx/pass_dump.cpp b/lib/gfx/pass_dump.cpp
new file mode 100644
--- /dev/null
+++ b/lib/gfx/pass_dump.cpp
@@ -0,0 +1,263 @@
+#include "pass_dump.hpp"
+
+#include "frame_packet.hpp"
+#include "../logging.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <png.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <vector>
+
+namespace aurora::gfx::pass_dump {
+using detail::RenderPass;
+using detail::TextureCopy;
+using detail::CommandType;
+namespace {
+constexpr Module Log{"aurora::gfx::pass_dump"};
+
+struct Range {
+  uint32_t first = 0;
+  uint32_t last = 0;
+  bool enabled = false;
+};
+
+const Range& selected_range() noexcept {
+  static const Range range = [] {
+    Range r;
+    const char* env = std::getenv("AURORA_DUMP_PASSES");
+    if (env == nullptr || *env == '\0') {
+      return r;
+    }
+    char* next = nullptr;
+    r.first = r.last = static_cast<uint32_t>(std::strtoul(env, &next, 10));
+    if (next == env) {
+      Log.warn("AURORA_DUMP_PASSES='{}' is not <first>-<last>; pass dump disabled", env);
+      return r;
+    }
+    if (*next == '-') {
+      r.last = static_cast<uint32_t>(std::strtoul(next + 1, nullptr, 10));
+    }
+    r.enabled = true;
+    Log.info("AURORA_DUMP_PASSES: dumping frames {}-{} to ./passdump/", r.first, r.last);
+    return r;
+  }();
+  return range;
+}
+
+struct Readback {
+  wgpu::Buffer buffer;
+  std::string name; // file stem, e.g. "pass3_efb"
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t bytesPerRow = 0;
+  bool bgra = false;
+};
+
+// Main-thread state for the frame being recorded. Owned by the FramePacket until it is written out.
+FrameDump* g_active = nullptr;
+
+bool write_png(const std::string& path, const Readback& rb, const uint8_t* data) {
+  FILE* file = std::fopen(path.c_str(), "wb");
+  if (file == nullptr) {
+    return false;
+  }
+  png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+  png_infop info = png != nullptr ? png_create_info_struct(png) : nullptr;
+  if (info == nullptr) {
+    png_destroy_write_struct(&png, nullptr);
+    std::fclose(file);
+    return false;
+  }
+  if (setjmp(png_jmpbuf(png))) {
+    png_destroy_write_struct(&png, &info);
+    std::fclose(file);
+    return false;
+  }
+  png_init_io(png, file);
+  png_set_IHDR(png, info, rb.width, rb.height, 8, PNG_COLOR_TYPE_RGBA, PNG_INTERLACE_NONE,
+               PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+  png_write_info(png, info);
+  std::vector<uint8_t> row(static_cast<size_t>(rb.width) * 4);
+  for (uint32_t y = 0; y < rb.height; ++y) {
+    const uint8_t* src = data + static_cast<size_t>(y) * rb.bytesPerRow;
+    for (uint32_t x = 0; x < rb.width; ++x) {
+      const uint8_t* s = src + x * 4;
+      uint8_t* d = &row[x * 4];
+      d[0] = rb.bgra ? s[2] : s[0];
+      d[1] = s[1];
+      d[2] = rb.bgra ? s[0] : s[2];
+      d[3] = s[3];
+    }
+    png_write_row(png, row.data());
+  }
+  png_write_end(png, nullptr);
+  png_destroy_write_struct(&png, &info);
+  std::fclose(file);
+  return true;
+}
+
+void read_texture(wgpu::CommandEncoder& cmd, FrameDump& dump, std::string name, const wgpu::Texture& texture,
+                  wgpu::Origin3D origin, wgpu::Extent3D size);
+} // namespace
+
+struct FrameDump {
+  uint32_t frameIndex = 0;
+  std::string log;     // written after the frame is submitted
+  std::string pending; // draw lines recorded since the last sealed pass (main thread)
+  std::vector<Readback> readbacks;
+};
+
+FrameDumpPtr begin_frame(uint32_t frameIndex) {
+  const auto& range = selected_range();
+  if (!range.enabled || frameIndex < range.first || frameIndex > range.last) {
+    g_active = nullptr;
+    return nullptr;
+  }
+  auto dump = std::make_shared<FrameDump>();
+  dump->frameIndex = frameIndex;
+  dump->log = fmt::format("frame {}\n", frameIndex);
+  g_active = dump.get();
+  return dump;
+}
+
+void end_frame() noexcept {
+  if (g_active != nullptr && !g_active->pending.empty()) {
+    g_active->log += g_active->pending;
+  }
+  g_active = nullptr;
+}
+
+bool active() noexcept { return g_active != nullptr; }
+
+void note_draw(const std::string& line) {
+  if (g_active != nullptr) {
+    g_active->pending += fmt::format("    draw {}\n", line);
+  }
+}
+
+void seal_pass(uint32_t passIndex, const RenderPass& pass) {
+  if (g_active == nullptr) {
+    return;
+  }
+  auto& out = g_active->log;
+  out += fmt::format("PASS {} '{}' colorAttachments={} discardable={} hasDraws={}\n", passIndex, pass.label,
+                     pass.colorAttachmentCount, pass.discardable, pass.hasDraws);
+  for (uint32_t i = 0; i < pass.colorAttachmentCount; ++i) {
+    const auto& ca = pass.colorAttachments[i];
+    const auto& cv = ca.clearValue;
+    out += fmt::format("  color{} {}x{} clear={} loadOp={} clearValue=({}, {}, {}, {})\n", i, ca.size.width,
+                       ca.size.height, ca.clear, static_cast<uint32_t>(ca.loadOp), cv.x(), cv.y(), cv.z(), cv.w());
+  }
+  if (pass.resolveTarget) {
+    const auto& r = pass.resolveRect;
+    out += fmt::format("  resolve rect=({}, {}, {}, {}) -> copy {}x{} format={}\n", r.x, r.y, r.width, r.height,
+                       pass.resolveTarget->size.width, pass.resolveTarget->size.height,
+                       static_cast<uint32_t>(pass.resolveFormat));
+  }
+  uint32_t draws = 0;
+  for (const auto& cmd : pass.commands) {
+    if (cmd.type == CommandType::Draw || cmd.type == CommandType::CustomDraw) {
+      ++draws;
+    } else if (cmd.type == CommandType::SetViewport) {
+      const auto& v = cmd.data.setViewport;
+      out += fmt::format("  viewport ({}, {}, {}, {}) z=({}, {})\n", v.left, v.top, v.width, v.height, v.znear,
+                         v.zfar);
+    } else if (cmd.type == CommandType::SetScissor) {
+      const auto& s = cmd.data.setScissor;
+      out += fmt::format("  scissor ({}, {}, {}, {})\n", s.x, s.y, s.width, s.height);
+    }
+  }
+  out += g_active->pending;
+  g_active->pending.clear();
+  out += fmt::format("  draws={}\n", draws);
+}
+
+void note_copy(uint32_t copyIndex, const TextureCopy& copy) {
+  if (g_active == nullptr) {
+    return;
+  }
+  g_active->log += fmt::format("COPY {} src=({}, {}, {}) dst=({}, {}, {}) size={}x{}\n", copyIndex,
+                               copy.src.origin.x, copy.src.origin.y, copy.src.origin.z, copy.dst.origin.x,
+                               copy.dst.origin.y, copy.dst.origin.z, copy.size.width, copy.size.height);
+}
+
+void read_pass(wgpu::CommandEncoder& cmd, FrameDump& dump, uint32_t passIndex, const RenderPass& pass) {
+  if (pass.copySourceTexture) {
+    read_texture(cmd, dump, fmt::format("pass{}_efb", passIndex), pass.copySourceTexture, {}, {
+        pass.copySourceTexture.GetWidth(), pass.copySourceTexture.GetHeight(), 1});
+  }
+  if (pass.resolveTarget) {
+    read_texture(cmd, dump, fmt::format("pass{}_resolve", passIndex), pass.resolveTarget->texture, {},
+                 pass.resolveTarget->size);
+  }
+}
+
+void read_copy(wgpu::CommandEncoder& cmd, FrameDump& dump, uint32_t copyIndex, const TextureCopy& copy) {
+  read_texture(cmd, dump, fmt::format("copy{}", copyIndex), copy.dst.texture, copy.dst.origin, copy.size);
+}
+
+void write_frame(FrameDump& dump) {
+  std::error_code ec;
+  std::filesystem::create_directories("passdump", ec);
+  const std::string prefix = fmt::format("passdump/frame{}", dump.frameIndex);
+  for (auto& rb : dump.readbacks) {
+    const uint64_t bytes = static_cast<uint64_t>(rb.bytesPerRow) * rb.height;
+    wgpu::MapAsyncStatus status = wgpu::MapAsyncStatus::Error;
+    auto future = rb.buffer.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::WaitAnyOnly,
+                                     [&status](wgpu::MapAsyncStatus s, wgpu::StringView) { status = s; });
+    webgpu::g_instance.WaitAny(future, 5'000'000'000ull);
+    if (status != wgpu::MapAsyncStatus::Success) {
+      dump.log += fmt::format("  {} readback failed\n", rb.name);
+      continue;
+    }
+    const auto* data = static_cast<const uint8_t*>(rb.buffer.GetConstMappedRange(0, bytes));
+    const auto path = fmt::format("{}_{}.png", prefix, rb.name);
+    if (!write_png(path, rb, data)) {
+      dump.log += fmt::format("  {} PNG write failed\n", path);
+    }
+    rb.buffer.Unmap();
+  }
+  if (FILE* log = std::fopen((prefix + ".log").c_str(), "w"); log != nullptr) {
+    std::fwrite(dump.log.data(), 1, dump.log.size(), log);
+    std::fclose(log);
+  }
+  Log.info("pass dump: frame {} written ({} readbacks)", dump.frameIndex, dump.readbacks.size());
+}
+
+namespace {
+void read_texture(wgpu::CommandEncoder& cmd, FrameDump& dump, std::string name, const wgpu::Texture& texture,
+                  wgpu::Origin3D origin, wgpu::Extent3D size) {
+  const auto format = texture.GetFormat();
+  const bool bgra = format == wgpu::TextureFormat::BGRA8Unorm || format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  const bool rgba = format == wgpu::TextureFormat::RGBA8Unorm || format == wgpu::TextureFormat::RGBA8UnormSrgb;
+  if (!bgra && !rgba) {
+    dump.log += fmt::format("  {} skipped: format {}\n", name, static_cast<uint32_t>(format));
+    return;
+  }
+  Readback rb{
+      .name = std::move(name),
+      .width = size.width,
+      .height = size.height,
+      .bytesPerRow = (size.width * 4 + 255) & ~255u,
+      .bgra = bgra,
+  };
+  const wgpu::BufferDescriptor desc{
+      .label = "Pass dump readback",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = static_cast<uint64_t>(rb.bytesPerRow) * rb.height,
+  };
+  rb.buffer = webgpu::g_device.CreateBuffer(&desc);
+  const wgpu::TexelCopyTextureInfo src{.texture = texture, .origin = origin};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = rb.bytesPerRow, .rowsPerImage = rb.height},
+      .buffer = rb.buffer,
+  };
+  const wgpu::Extent3D copySize{.width = size.width, .height = size.height, .depthOrArrayLayers = 1};
+  cmd.CopyTextureToBuffer(&src, &dst, &copySize);
+  dump.readbacks.push_back(std::move(rb));
+}
+} // namespace
+} // namespace aurora::gfx::pass_dump
diff --git a/lib/gfx/pass_dump.hpp b/lib/gfx/pass_dump.hpp
new file mode 100644
--- /dev/null
+++ b/lib/gfx/pass_dump.hpp
@@ -0,0 +1,49 @@
+#pragma once
+
+// Opt-in per-pass pixel dump (debug aid).
+//
+// AURORA_DUMP_PASSES=<first>-<last> (or a single <frame>) selects frames by gfx::current_frame(). For each selected
+// frame, files are written to ./passdump/ relative to the working directory:
+//   frame<N>.log                  pass boundaries: label, clears, resolve rect, copies, viewport/scissor, draw count
+//                                 and the textures every draw samples
+//   frame<N>_pass<K>_efb.png      EFB colour after render pass K
+//   frame<N>_pass<K>_resolve.png  copy texture written by pass K's resolve (when present)
+//   frame<N>_copy<K>.png          destination of texture copy K
+// When the variable is unset, begin_frame() costs one cached check and nothing is recorded or read back. Readbacks
+// block the render worker after submit, so this is for debugging only. Formats other than RGBA8/BGRA8 are logged as
+// skipped.
+
+#include "types.hpp"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace aurora::gfx::detail {
+struct RenderPass;
+struct TextureCopy;
+} // namespace aurora::gfx::detail
+
+namespace aurora::gfx::pass_dump {
+struct FrameDump;
+using FrameDumpPtr = std::shared_ptr<FrameDump>;
+
+// Main thread: called from begin_frame. Null unless frameIndex is selected.
+FrameDumpPtr begin_frame(uint32_t frameIndex);
+// Main thread: stops recording into the frame that began.
+void end_frame() noexcept;
+// Main thread: true while the frame being recorded is dumped.
+bool active() noexcept;
+// Main thread: appends a draw description to the open pass.
+void note_draw(const std::string& line);
+// Main thread: a render pass was sealed; writes its header and the draws recorded since the previous pass.
+void seal_pass(uint32_t passIndex, const detail::RenderPass& pass);
+// Main thread: a texture copy was queued.
+void note_copy(uint32_t copyIndex, const detail::TextureCopy& copy);
+// Render worker: records readbacks for the EFB and resolve target after a pass is encoded.
+void read_pass(wgpu::CommandEncoder& cmd, FrameDump& dump, uint32_t passIndex, const detail::RenderPass& pass);
+// Render worker: records a readback of a texture copy destination.
+void read_copy(wgpu::CommandEncoder& cmd, FrameDump& dump, uint32_t copyIndex, const detail::TextureCopy& copy);
+// Render worker, after the frame is submitted: maps readbacks, writes PNGs and the log.
+void write_frame(FrameDump& dump);
+} // namespace aurora::gfx::pass_dump
