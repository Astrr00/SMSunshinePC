+/**
+ * Sets the host pointer backing a texture map slot. Emitted by GDSetTexImgPtr, which J3D uses because its BP
+ * image pointer is a 24-bit physical address. Must be followed by a u8 texture map id and a u64 host pointer.
+ * Image size and format still come from the BP image0 register.
+ */
+#define GX_AURORA_SET_TEX_DATA 0x0045
+
+/**
+ * Sets the host pointer and entry count of a TLUT slot. Emitted by GDLoadTlut.
+ * Must be followed by a u8 TLUT slot, a u64 host pointer, and a u16 entry count.
+ */
+#define GX_AURORA_SET_TLUT_DATA 0x0046
+
+/**
+ * Binds a TLUT slot to a texture map and sets its palette format. Emitted by GDSetTexTlut.
+ * Must be followed by a u8 texture map id, a u8 TLUT slot, and a u32 GXTlutFmt.
+ */
+#define GX_AURORA_SET_TEX_TLUT 0x0047
 
