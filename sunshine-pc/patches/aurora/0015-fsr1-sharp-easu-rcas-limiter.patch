+fn lanczos2(x: f32) -> f32 {
+    let ax = abs(x);
+    if (ax >= 2.0) {
+        return 0.0;
+    }
+    if (ax < 1e-4) {
+        return 1.0;
+    }
+    let px = 3.14159265 * ax;
+    return 2.0 * sin(px) * sin(0.5 * px) / (px * px);
+}
