+    const auto* old = static_cast<const uint8_t*>(dest);
+    size_t changed = 0;
+    size_t nonzeroOld = 0;
+    size_t nonzeroNew = 0;
+    for (size_t i = 0; i < entry.staged.size(); ++i) {
+      changed += old[i] != entry.staged[i];
+      nonzeroOld += old[i] != 0;
+      nonzeroNew += entry.staged[i] != 0;
