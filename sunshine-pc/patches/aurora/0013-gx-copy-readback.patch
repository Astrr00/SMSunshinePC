+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = entry.rowPitch, .rowsPerImage = entry.height},
+      .buffer = entry.buffer,
+  };
+  const wgpu::Extent3D extent{.width = entry.width, .height = entry.height, .depthOrArrayLayers = 1};
