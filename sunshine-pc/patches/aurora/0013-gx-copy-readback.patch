+void apply_copy_readback(void* dest, uint32_t width, uint32_t height, uint32_t fmt) noexcept {
+  if (fmt != GX_CTF_R8) {
+    return;
+  }
+  std::lock_guard lock{g_mutex};
+  const auto it = g_copyReadbacks.find(dest);
+  if (it == g_copyReadbacks.end()) {
+    return;
+  }
+  auto& entry = it->second;
+  if (entry.width != width || entry.height != height) {
+    return;
+  }
+  const uint32_t seq = ++entry.gameCopies; // this GXCopyTex is copy #seq of the registration
+  if (!entry.hasStaged) {
+    return;
+  }
+  const uint32_t latency = seq - entry.stagedSeq; // frames between the copy read back and this write (0 on GameCube)
+  entry.latencyMin = std::min(entry.latencyMin, latency);
+  entry.latencyMax = std::max(entry.latencyMax, latency);
+  if (++entry.applies == 300) {
+    Log.info("Copy readback: 300 applies to {}, latency {}..{} frames", dest, entry.latencyMin, entry.latencyMax);
+  }
+  if (!entry.loggedApply) {
