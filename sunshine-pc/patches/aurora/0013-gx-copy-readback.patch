+std::unordered_map<const void*, CopyReadback> g_copyReadbacks;
+uint64_t g_copyGen = 0;
+bool g_copyLoggedUnavailable = false;
+
+struct PendingCopyMap {
+  const void* dest = nullptr;
+  uint64_t gen = 0;
+  wgpu::Buffer buffer;
+  uint64_t byteSize = 0;
+};
+
+// Map callback: RGBA8 rows (r = the R8 copy value) -> GX I8 tiles (8x4 texels, 32 bytes per tile), the inverse of
+// DecodeTiled<I8>.
+void complete_copy_readback(const PendingCopyMap& pending, wgpu::MapAsyncStatus status, wgpu::StringView message) {
+  std::lock_guard lock{g_mutex};
+  const auto it = g_copyReadbacks.find(pending.dest);
+  const bool alive = it != g_copyReadbacks.end() && it->second.gen == pending.gen &&
+                     it->second.buffer.Get() == pending.buffer.Get();
+  if (status == wgpu::MapAsyncStatus::Success) {
+    const auto* mapped = static_cast<const uint8_t*>(pending.buffer.GetConstMappedRange(0, pending.byteSize));
+    if (alive && mapped != nullptr) {
+      auto& entry = it->second;
+      const uint32_t w = entry.width;
+      const uint32_t h = entry.height;
+      entry.staged.resize(static_cast<size_t>(w) * h);
+      for (uint32_t t = 0; t < h; ++t) {
+        const uint8_t* row = mapped + static_cast<size_t>(t) * entry.rowPitch;
+        for (uint32_t s = 0; s < w; ++s) {
+          entry.staged[((t >> 2) * (w >> 3) + (s >> 3)) * 32 + (t & 3) * 8 + (s & 7)] = row[s * 4];
+        }
+      }
+      entry.hasStaged = true;
+      entry.stagedSeq = entry.inflightSeq;
+    }
+    pending.buffer.Unmap();
+  } else if (status != wgpu::MapAsyncStatus::CallbackCancelled && status != wgpu::MapAsyncStatus::Aborted) {
+    Log.warn("Copy readback mapping failed {}: {}", magic_enum::enum_name(status), message);
+  }
+  if (alive) {
+    it->second.state = SlotState::Available;
+  }
+}
