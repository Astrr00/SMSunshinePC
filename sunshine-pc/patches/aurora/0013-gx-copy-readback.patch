+struct CopyReadback {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint64_t gen = 0;
+  wgpu::Buffer buffer;
+  uint32_t rowPitch = 0;
+  SlotState state = SlotState::Available;
+  std::vector<uint8_t> staged;
+  bool hasStaged = false;
+  bool loggedApply = false;
+  bool loggedMismatch = false;
+  // Latency bookkeeping (log only): copies counted per registration on the game thread (GXCopyTex) and the render
+  // worker (encode), which see the same copies in the same order.
+  uint32_t gameCopies = 0;
+  uint32_t encodedCopies = 0;
+  uint32_t inflightSeq = 0;
+  uint32_t stagedSeq = 0;
+  uint32_t applies = 0;
+  uint32_t latencyMin = UINT32_MAX;
+  uint32_t latencyMax = 0;
