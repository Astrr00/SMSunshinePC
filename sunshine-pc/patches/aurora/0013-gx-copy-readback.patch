+bool copy_readback_gen(const void* dest, uint32_t dstWidth, uint32_t dstHeight, uint32_t srcWidth,
+                       uint32_t srcHeight, uint64_t& gen) noexcept {
+  std::lock_guard lock{g_mutex};
