+// Last draws seen by the FIFO parser, kept to explain a stream that goes out of sync (see handle_draw_overrun).
+struct DrawRecord {
+  u8 cmd = 0;
+  u16 vtxCount = 0;
+  u32 vtxSize = 0;
+  size_t pos = 0;
+  std::array<u8, GX_VA_MAX_ATTR> desc{};
+  std::array<u8, GX_VA_MAX_ATTR> type{};
+  std::array<u8, GX_VA_MAX_ATTR> cnt{};
+};
+static constexpr size_t kDrawRingSize = 8;
+static std::array<DrawRecord, kDrawRingSize> sDrawRing;
+static size_t sDrawRingNext = 0;
+
+static void record_draw(u8 cmd, GXVtxFmt fmt, u16 vtxCount, u32 vtxSize, size_t pos) noexcept {
+  auto& r = sDrawRing[sDrawRingNext++ % kDrawRingSize];
+  r.cmd = cmd;
+  r.vtxCount = vtxCount;
+  r.vtxSize = vtxSize;
+  r.pos = pos;
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  for (int i = 0; i < GX_VA_MAX_ATTR; ++i) {
+    r.desc[i] = static_cast<u8>(g_gxState.vtxDesc[i]);
+    r.type[i] = static_cast<u8>(vtxFmt.attrs[i].type);
+    r.cnt[i] = static_cast<u8>(vtxFmt.attrs[i].cnt);
+  }
+}
+
+static void dump_draw_ring() noexcept {
+  const size_t n = std::min(sDrawRingNext, kDrawRingSize);
+  for (size_t k = n; k > 0; --k) {
+    const auto& r = sDrawRing[(sDrawRingNext - k) % kDrawRingSize];
+    std::string attrs;
+    for (int i = 0; i < GX_VA_MAX_ATTR; ++i) {
+      if (r.desc[i] != GX_NONE) {
+        attrs += fmt::format(" a{}:d{}t{}c{}", i, r.desc[i], r.type[i], r.cnt[i]);
+      }
+    }
+    Log.error("  draw[-{}] cmd=0x{:02X} vtxCount={} vtxSize={} data@{}{}", k - 1, r.cmd, r.vtxCount, r.vtxSize, r.pos,
+              attrs);
+  }
+}
