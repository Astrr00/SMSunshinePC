+// Prints the GXBegin calls around `absPos`: the 4 before it and the 3 after it.
+void aurora_gx_dump_begin_ring(u64 absPos) {
+  const size_t n = sBeginRingNext < kBeginRingSize ? sBeginRingNext : kBeginRingSize;
+  size_t hit = n; // index (oldest = 0) of the last begin at or before absPos
+  for (size_t i = 0; i < n; ++i) {
+    const auto& r = sBeginRing[(sBeginRingNext - n + i) % kBeginRingSize];
+    if (r.fifoOffset <= absPos) {
+      hit = i;
+    }
+  }
+  Log.error("  failing position {} abs; {} GXBegin calls recorded", absPos, n);
+  if (hit == n) {
+    return;
+  }
+  const size_t from = hit >= 4 ? hit - 4 : 0;
+  const size_t to = std::min(n, hit + 4);
+  for (size_t i = from; i < to; ++i) {
+    const auto& r = sBeginRing[(sBeginRingNext - n + i) % kBeginRingSize];
+    Log.error("  begin{} cmd=0x{:02X} nVerts={} abs@{} caller={}", i == hit ? "*" : " ", r.cmd, r.nVerts, r.fifoOffset,
+              r.caller);
+  }
+}
