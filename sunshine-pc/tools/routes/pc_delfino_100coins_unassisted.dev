# Original spin jump: vY70; X is allowed during ROTATE_JUMP, unlike BACK_JUMP.
# Hold A through ascent; swap to Hover only after reaching the desired launch height.
faceto x=72 z=13232 tol=3 timeout=240
wait frames=15
wait frames=20
trace frames=180
