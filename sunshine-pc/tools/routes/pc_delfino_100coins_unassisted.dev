# Controller-only boat1 boarding from the far manhole/basket island; primary nozzle selected.
# Cover10 (-19411,300,-3496). East shore is a continuous original slope: x-19000 y286.7 -> x-18100 y42.7.
# Boat1 S_ship1 northbound passes x~-17250, z-4400..-2600, speed4.
# Retry ordinary spin-jump+Hover to fixed intercept; existing floory observes boat beneath airborne Mario.
label boat_retry
walkto x=-18200 z=-3500 radius=120 timeout=1800
hold R trig=0,255 frames=2
wait frames=30
waitfor marioy>=30 floory>=25 timeout=180
# Face and settle the camera BEFORE waiting for the approaching original boat.
