# ModCheck: "Unlock all nozzles" picked in the launcher, then an existing save loaded in the file select (block B, x=1080, as 86_accept_reload.dev).
# Run: python tools/route.py Strict tools/routes/99_nozzle_load.dev --no-dvd --appdata-from <run with a save and [launcher] last_image> --name <n>
#   SUNSHINE_DEV_SKIP_MOVIES=1 SUNSHINE_DEV_SEED=1 SUNSHINE_DEV_NO_SHELL=1 SUNSHINE_DEV_LAUNCHER_ACTIONS=cheat-4,start
# Pass: [cheats-state] nozzles=0x3FFFF in Delfino (stage 1, where that save loads) (control without cheat-4: 0x00000).
waitfor stage=15 dirstate=4 timeout=6000
wait frames=240
mash A period=30 until cardmode=0 timeout=900
wait frames=30
walkto x=1080 z=-1000 radius=25 timeout=600
log
hold A frames=4
wait frames=26
hold A frames=4
wait frames=26
hold A frames=4
wait frames=26
log
mash A period=30 until stage=1 director mario dirstate=4 camDemo=0 timeout=6000
log
wait frames=150
log
end
