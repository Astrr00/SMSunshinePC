# Diagnosis only (airport/1 + Null backend, uses dev cheats and teleports): squat-spray at 45 degrees from about 320 units.
waitfor stage=0 scen=1 director mario dirstate=4 timeout=3000
cheat infinite_health
cheat infinite_water
wait frames=30
log
tp x=-1200 y=320 z=1180 yaw=-43
wait frames=6
hold L trig=255,255 stick=0,127 frames=45
log
