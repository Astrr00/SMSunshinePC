# Diagnosis only (airport/1 + Null backend, uses dev cheats and teleports): Squat with L only, then R only with stick back (nozzle up); facing from the tp yaw only, no aimhead.
waitfor stage=0 scen=1 director mario dirstate=4 timeout=3000
cheat infinite_health
cheat infinite_water
wait frames=30
log
tp x=-997 y=320 z=1034 yaw=-47
wait frames=45
hold L trig=255,0 frames=12
hold trig=0,255 stick=0,-50 frames=60
