# Diagnosis only (airport/1 + Null backend, uses dev cheats and teleports): Enter the squat with L+R (6 frames after the tp as in b15), then R only with stick back; facing only from the tp yaw, no aimhead.
waitfor stage=0 scen=1 director mario dirstate=4 timeout=3000
cheat infinite_health
cheat infinite_water
wait frames=30
log
tp x=-997 y=320 z=1034 yaw=-47
wait frames=6
hold L trig=255,255 stick=0,-60 frames=10
hold trig=0,255 stick=0,-60 frames=60
