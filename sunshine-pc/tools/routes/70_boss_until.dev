log
shot ap0.png
wait frames=90
hold A frames=4
wait frames=60
# y=500 plateau waypoints from airport0 map.col (+-70 units margin); the y=300 pit is goop (OIL_SLIP, health loss).
walkto x=-1198 z=167 radius=150 timeout=3000
walkto x=-5876 z=976 radius=150 timeout=4500
walkto x=-6630 z=1600 radius=250 timeout=3000
waitfor thp=2 timeout=3000
log
# thp=0 flickers at the start of a movie: let it run, then wait for the real end.
wait frames=600
waitfor thp=0 timeout=15000
shot movie_end.png
# A answers the prompt (cursor on No); stage/scen already read 0/1 during the movie, so wait for the new director.
mash A period=30 until stage=0 scen=1 director mario dirstate=4 timeout=15000
log
shot tut0.png
# Tutorial: the M graffiti is at about (-6301, 536, 2350); walk toward it (faces it), then spray with the analog R trigger.
walkto x=-6300 z=2150 radius=60 timeout=3000
log
hold trig=0,255 frames=240
log
shot wash.png
wait frames=60
log
