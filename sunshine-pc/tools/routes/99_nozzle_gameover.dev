# ModCheck: "Unlock all nozzles" (launcher cheat-4) on a new file, then a game over before the first save (4 x hurt 8, lives 3 -> -1).
# Run: python tools/route.py Strict tools/routes/99_nozzle_gameover.dev --no-dvd --appdata-from <run with only [launcher] last_image> --name <n>
#   --seconds 330 SUNSHINE_DEV_SKIP_MOVIES=1 SUNSHINE_DEV_SEED=1 SUNSHINE_DEV_NO_SHELL=1 SUNSHINE_DEV_LAUNCHER_ACTIONS=cheat-4,start
# Game over -> STATE_CARD_SAVE (unk261=7, MarDirectorDirect.cpp:454) -> continue -> TFlagManager::restore() (:409). Watch nozzles= after it.
waitfor stage=15 dirstate=4 timeout=6000
wait frames=240
mash A period=30 until cardprog=19 timeout=900
walkto x=1080 z=-1000 radius=20 timeout=600
mash A period=24 until cardprog=27 timeout=900
mash A period=30 until stage=0 timeout=2400
waitfor stage=0 scen=0 director mario dirstate=4 camDemo=0 timeout=5400
# Airport scen 0 opens with Peach's talk (Mario status 0x10001308) after every respawn: the A presses close it, then hurt kills.
wait frames=90
hold A frames=4
wait frames=60
hold A frames=4
wait frames=60
log
hurt 8
wait frames=420
waitfor stage=0 director mario dirstate=4 camDemo=0 timeout=3000
wait frames=90
hold A frames=4
wait frames=60
hold A frames=4
wait frames=60
log
hurt 8
wait frames=420
waitfor stage=0 director mario dirstate=4 camDemo=0 timeout=3000
wait frames=90
hold A frames=4
wait frames=60
hold A frames=4
wait frames=60
log
hurt 8
wait frames=420
waitfor stage=0 director mario dirstate=4 camDemo=0 timeout=3000
wait frames=90
hold A frames=4
wait frames=60
hold A frames=4
wait frames=60
log
hurt 8
wait frames=420
# 4th death: lives -1 -> game over screen (dir.state 11 = STATE_CARD_SAVE), no gameplay state to wait for
wait frames=200
log
shot go1.png
hold A frames=4
wait frames=90
shot go2.png
hold A frames=4
wait frames=90
shot go3.png
hold A frames=4
wait frames=90
shot go4.png
log
mash A period=45 until stage=0 director mario dirstate=4 camDemo=0 timeout=4000
wait frames=90
hold A frames=4
wait frames=150
log
end
