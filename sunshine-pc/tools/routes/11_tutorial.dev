# Airport tutorial: briefing movie -> "hear the story again?" prompt (No) -> stage 0 scen 1 FLUDD tutorial -> next stage.
# Run: SUNSHINE_DEV_SKIP_MOVIES=1 python tools/route.py Strict tools/routes/11_tutorial.dev --name <n> --seconds 320 SUNSHINE_DEV_START=airport/0 SUNSHINE_DEV_STEP_RETRACE=1 SUNSHINE_ALLOW_CPU_ADAPTER=0 (Null backend: spray/water checks only, PNGs blank; ALLOW_CPU_ADAPTER=1 renders but runs ~12 ticks/s)
# Observed: stage=0 scen=1 is already set while the briefing movie plays (thp=2 from tick ~600); the movie really ends at ~18780 (thp=0).
waitfor stage=0 scen=0 director mario dirstate=4 timeout=3000
wait frames=90
hold A frames=4
wait frames=60
walkto x=-1198 z=167 radius=150 timeout=600
walkto x=-5876 z=976 radius=150 timeout=900
walkto x=-6630 z=1600 radius=250 timeout=600
waitfor thp=2 timeout=600
wait frames=18500
waitfor thp=0 timeout=3000
wait frames=60
log
mash A period=30 until director mario dirstate=4 timeout=3000
log
# Spray sweep: analog R (trig=0,255) sprays; stick moves Mario while R is held. Log + shot after each segment.
wait frames=30
hold trig=0,255 frames=90
log
shot s1.png
hold trig=0,255 stick=0,127 frames=60
log
shot s2.png
hold trig=0,255 stick=-127,0 frames=60
log
shot s3.png
hold trig=0,255 stick=127,0 frames=60
log
shot s4.png
hold trig=0,255 stick=0,-127 frames=60
log
shot s5.png
end
