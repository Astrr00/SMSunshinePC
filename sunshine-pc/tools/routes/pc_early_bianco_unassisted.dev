# Earned airport checkpoint -> ordinary fileB load -> Delfino boss -> Shadow Mario -> live Bianco episode0 -> real mission Shine -> save/return.
# First earn the profile with pc_airport_unassisted.dev, then use route.py --appdata-from <earned-run>.
# SUNSHINE_DEV_NAV must name the locally generated corrected dolpic1 grid; no devstart or gameplay aids.
# All actions are controller inputs. Natural game scripts may move Mario during normal demos/transitions.
# Script end uses diagnostic _Exit; normal native Close and non-default settings require separate checks.
waitfor stage=15 dirstate=4 timeout=6000
wait frames=240
mash A period=30 until cardmode=0 timeout=900
wait frames=30
walkto x=1080 z=-1000 radius=25 timeout=600
hold A frames=4
wait frames=26
hold A frames=4
wait frames=26
hold A frames=4
wait frames=26
waitfor thp=2 timeout=1500
wait frames=600
mash A period=30 until stage=1 director mario dirstate=4 camDemo=0 timeout=15000
log
waitfor stage=1 scen=0 director mario dirstate=4 camDemo=0 timeout=3000
wait frames=60
log
walkto x=5380 z=2700 radius=150 timeout=1200
walkto x=4980 z=3100 radius=150 timeout=600
# Wash before crossing the pollution boundary; A clears OilRun horizontal velocity.
walkto x=1600 z=5800 radius=80 spray=1 timeout=900
walkto x=12 z=5450 radius=45 spray=1 timeout=600
log
hold A frames=1
log
# Keep L released in flight: its edge is ground-pound.
wait frames=45
log
faceto x=12 z=4631 tol=3 timeout=180
hold L frames=10
log
hold L trig=0,255 until bck=0 timeout=600
log
waitfor camDemo=0 timeout=900
wait frames=1
hold L frames=10
log
# Goop initially turns Mario instead of the nozzle. Clean, then reacquire facing and squat.
hold R stick=0,-127 frames=28
hold R frames=240
log
faceto x=12 z=4631 tol=3 timeout=180
hold L frames=15
log
hold R stick=0,-127 frames=28
# Source/trace: seven dry forward-stick L ticks lower the sampled overshot pitch.
hold L stick=0,127 frames=7
hold L frames=3
log
# shortcut: sixteen pad ticks enter the real throat window at current pacing; resample if pacing changes.
hold L until bck=18 timeout=900
hold L frames=16
hold R until bck=3 timeout=300
log
hold L until bck=18 timeout=900
hold L frames=16
hold R until bck=3 timeout=300
log
hold L until bck=18 timeout=900
hold L frames=16
hold R until bck=5 timeout=300
log
waitfor stage=1 scen=1 director mario dirstate=4 camDemo=0 timeout=3000
log
shot gatekeeper_defeated.png
waitfor stage=1 scen=1 director mario dirstate=4 camDemo=0 timeout=6000
wait frames=60
walkto x=5020 z=3060 radius=150 timeout=2400
walkto x=5540 z=300 radius=150 timeout=2400
log
chase timeout=5000 radius=900
log
shot shadow_dialogue.png
mash A period=30 until talk=0 timeout=2400
wait frames=300
log
# Return through the physically verified lower corridor, not the old upper-ramp wall.
walkto x=5700 z=-4000 radius=100 timeout=900
walkto x=5700 z=300 radius=100 timeout=900
walkto x=5020 z=3060 radius=150 timeout=2400
walkto x=2340 z=3220 radius=100 timeout=1800
log
walkto x=340 z=5020 radius=60 timeout=1800 spray=1
wait frames=30
waitfor camDemo=0 timeout=900
waitfor flag=0x10385 timeout=3000
waitfor camDemo=0 timeout=900
log
faceto x=0 z=4941 timeout=600
hold trig=0,255 frames=120
log
hold trig=0,255 frames=120
log
hold trig=0,255 frames=120
log
wait frames=300
walkto x=0 z=4800 radius=200 timeout=600
log
shot gate.png
hold A stick=0,127 frames=120
log
waitfor stage=2 timeout=1200
wait frames=400
mash A period=40 until stage=2 scen=0 director mario dirstate=4 camDemo=0 timeout=2400
wait frames=120
log
hold stick=0,127 frames=60
log
hold A stick=0,127 frames=30
wait frames=60
log
shot bianco_controllable.png
# Continue the actual event0 mission; the 100-coin reward is not a substitute.
walkto x=-5900 z=16260 radius=30 timeout=1361
walkto x=-2740 z=11660 radius=30 timeout=1735
walkto x=-1140 z=10060 radius=30 timeout=739
walkto x=-880 z=9420 radius=30 timeout=268
walkto x=-560 z=8920 radius=30 timeout=239
walkto x=-440 z=8820 radius=30 timeout=107
walkto x=-380 z=8780 radius=50 timeout=82
log
# Spin jump (MarioMove.cpp:1602) gives the lift needed for the walkway.
hold X frames=1
wait frames=1
# Small stick circle records spin input without walking off the takeoff ledge.
hold stick=40,0 frames=1
hold stick=28,-28 frames=1
hold stick=0,-40 frames=1
hold stick=-28,-28 frames=1
hold stick=-40,0 frames=1
hold stick=-28,28 frames=1
hold stick=0,40 frames=1
hold stick=28,28 frames=1
hold A stick=45,119 frames=14
log
walkto x=500 z=7800 radius=250 spray=1 timeout=400
walkto x=500 z=7800 radius=60 timeout=200
wait frames=30
walkto x=500 z=7400 radius=50 timeout=250
walkto x=750 z=7100 radius=50 timeout=250
walkto x=1000 z=6800 radius=50 timeout=250
log
shot bianco_walkway.png
# Stay on the main bridge; the eastward spur ends over water.
walkto x=1160 z=4960 radius=30 timeout=615
walkto x=920 z=3480 radius=30 timeout=510
walkto x=840 z=3320 radius=30 timeout=114
walkto x=880 z=3280 radius=30 timeout=177
walkto x=5840 z=1080 radius=50 timeout=1688
walkto x=6040 z=800 radius=50 timeout=264
hold X frames=1
wait frames=1
walkto x=7050 z=-300 radius=50 spray=1 timeout=742
hold A frames=1
wait frames=45
faceto x=7050 z=-1250 tol=3 timeout=180
hold L frames=10
log
shot bianco_boss_approach.png
# Wake the actual generic Bianco boss through body-water hits.
hold L trig=0,255 until bck=17 timeout=900
waitfor camDemo=0 timeout=1200
wait frames=30
faceto x=7050 z=-1250 tol=3 timeout=180
hold L until bck=18 timeout=900
# Squat-pitch calibration uses only the ordinary main stick.
hold L stick=0,-127 frames=10
hold L frames=16
log
shot bianco_boss_aim.png
# Camera release alone is not a ready throat; observe the awake and mouth phases before pitching.
hold R until bck=3 timeout=300
log
hold L until bck=18 timeout=900
# shortcut: sixteen pad ticks enter the 50..160 throat window at current pacing; resample after pacing changes.
hold L frames=16
hold R until bck=3 timeout=300
log
hold L until bck=18 timeout=900
hold L frames=16
hold R until bck=5 timeout=300
log
waitfor flag=0x50000 timeout=3000
waitfor camDemo=0 timeout=3000
waitfor dirstate=4 timeout=1200
log
shot bianco_event0_reveal.png
# The reward rises at (7170,3675,-185), then flies to its real resting point.
walkto x=7170 z=-185 radius=70 timeout=900
walkto x=7065 z=-1200 radius=50 timeout=600
hold A until flag=0x10000 timeout=900
log
shot bianco_event0_collected.png
mash A period=30 until stage=1 director mario dirstate=4 camDemo=0 timeout=9000
log
shot bianco_normal_return.png
wait frames=60
end
