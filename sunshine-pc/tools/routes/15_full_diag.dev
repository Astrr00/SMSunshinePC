# Diagnosis only: the full retail flow from the logos (no start switch) with SUNSHINE_DEV_SKIP_MOVIES=1, which ends every THP
# movie as soon as it starts (saves about 100 s of wall time). Run:
#   ROUTE_NOLOCK=1 python tools/route.py Strict tools/routes/15_full_diag.dev --name <n> --seconds 240 SUNSHINE_DEV_SKIP_MOVIES=1
# Same states as 12_tutorial_full.dev (title -> new game -> airport0 -> walk -> briefing -> prompt -> FLUDD tutorial -> spray),
# but no thp conditions. Never an acceptance run (the acceptance flow must not use skip switches).
waitfor stage=15 dirstate=4 timeout=6000
wait frames=240
mash A period=30 until cardprog=19 timeout=900
walkto x=1080 z=-1000 radius=20 timeout=600
mash A period=24 until cardprog=27 timeout=900
mash A period=30 until stage=0 timeout=2400
waitfor stage=0 scen=0 director mario dirstate=4 timeout=5400
log
wait frames=90
hold A frames=4
wait frames=60
walkto x=-1198 z=167 radius=150 timeout=600
walkto x=-5876 z=976 radius=150 timeout=900
walkto x=-6630 z=1600 radius=250 timeout=600
wait frames=120
log
mash A period=30 until stage=0 scen=1 director mario dirstate=4 timeout=3000
log
walkto x=-6300 z=2150 radius=60 timeout=600
log
hold trig=0,255 frames=240
log
wait frames=60
log
end
